{
  "name": "alkin/unsaved-form-bundle",
  "description": "A tiny Stimulus controller that warns about unsaved Symfony form changes before navigation.",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "symfony",
    "symfony-ux",
    "stimulus",
    "turbo",
    "forms",
    "unsaved-changes"
  ],
  "require": {
    "php": "^8.2",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/stimulus-bundle": "^2.9 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "Novora\\UnsavedFormBundle\\": "src/"
    }
  },
  "support": {
    "issues": "https://github.com/alkinbg/UnsavedFormBundle/issues",
    "source": "https://github.com/alkinbg/UnsavedFormBundle"
  },
  "homepage": "https://github.com/alkinbg/UnsavedFormBundle"
}
